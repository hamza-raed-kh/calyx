# Copy to ops/.env and fill in. ops/.env is gitignored.

# --- Django ---
DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DJANGO_DEBUG=false
DJANGO_LOG_LEVEL=INFO
# Add the tailnet hostname on the server, e.g. tasks.tailnet-xxxx.ts.net
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost
ALLOW_SIGNUPS=false

# --- Postgres ---
POSTGRES_DB=tasks
POSTGRES_USER=tasks
POSTGRES_PASSWORD=change-me

# --- Serving ---
# localhost for local development; tasks.<tailnet>.ts.net on the home server.
SITE_ADDRESS=localhost

# --- Images (set by deploy.sh on the server; unset locally to build) ---
# API_IMAGE=ghcr.io/OWNER/tasks-api:v1.0.0
# WEB_IMAGE=ghcr.io/OWNER/tasks-web:v1.0.0
