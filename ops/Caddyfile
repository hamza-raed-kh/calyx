{
	# Caddy fetches certificates for *.ts.net names from the local tailscaled
	# at handshake time. Requires the socket mount from
	# docker-compose.tailscale.yml. For SITE_ADDRESS=localhost, Caddy uses its
	# own internal CA instead and the socket is never touched.
	admin off
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# Cross-origin isolation, OFF by default.
	#
	# Enabling it (COOP=same-origin, COEP=require-corp) lets Chromium use OPFS
	# with locks, which is properly durable. It also makes SharedWorkers
	# unavailable in Firefox -- the path Firefox's storage backend needs -- so an
	# isolated origin can leave Firefox waiting forever on a database that never
	# opens. Working in every browser beats a better storage tier in one.
	#
	# If you do enable it: every subresource then needs a CORP/CORS header, and
	# the first remote <link> (Google Fonts is the classic) will break the page.
	header {
		Cross-Origin-Opener-Policy "{$COOP_VALUE:unsafe-none}"
		Cross-Origin-Embedder-Policy "{$COEP_VALUE:unsafe-none}"
		Cross-Origin-Resource-Policy "same-origin"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /admin/* {
		reverse_proxy api:8000
	}

	handle /static/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv/web/current

		# The service worker and entry point must never be cached, or the app
		# pins itself to a stale build.
		@nocache path /flutter_service_worker.js /index.html /version.json
		header @nocache Cache-Control "no-cache, must-revalidate"

		# Hashed assets are immutable.
		@immutable path /assets/* /canvaskit/* *.wasm
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}

	handle_errors {
		@notdeployed expression {err.status_code} == 404
		respond @notdeployed "Flutter web bundle not deployed yet. Run: docker compose --profile app up web" 503
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
